# BlackBox environment configuration
# Copy to .env and fill in values. NEVER commit .env.

# Required: Claude API key for the investigation agent
ANTHROPIC_API_KEY=sk-ant-...

# DataHub OSS (local quickstart defaults)
DATAHUB_GMS_URL=http://localhost:8080
# Optional: only needed if METADATA_SERVICE_AUTH_ENABLED=true on your DataHub
DATAHUB_GMS_TOKEN=

# Backend
BLACKBOX_API_PORT=8400

# Optional: after a VERIFIED repair, push the fix branch and open a real GitHub PR
# via `gh`. Leave false for demos/evals — true makes a run touch a remote.
BLACKBOX_CREATE_PR=false

# Frontend (Next.js)
NEXT_PUBLIC_BLACKBOX_API_URL=http://localhost:8400
