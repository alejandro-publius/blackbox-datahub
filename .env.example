# BlackBox environment configuration
# Copy to .env and fill in values. NEVER commit .env.

# Required: Claude API key for the investigation agent
ANTHROPIC_API_KEY=sk-ant-...

# DataHub OSS (local quickstart defaults)
DATAHUB_GMS_URL=http://localhost:8080
# Optional: only needed if METADATA_SERVICE_AUTH_ENABLED=true on your DataHub
DATAHUB_GMS_TOKEN=

# Backend
BLACKBOX_API_PORT=8400

# Frontend (Next.js)
NEXT_PUBLIC_BLACKBOX_API_URL=http://localhost:8400
