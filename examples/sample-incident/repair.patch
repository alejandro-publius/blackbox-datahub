--- a/pipeline/transforms/stg_orders.sql
+++ b/pipeline/transforms/stg_orders.sql
@@ -1,5 +1,14 @@
 -- stg_orders: cleaned order stream.
 -- Excludes cancelled and refunded orders from the revenue path.
+--
+-- UNIT NORMALIZATION (incident 2026-08-07, cloudpay_v2 cutover):
+-- The raw.raw_orders.amount contract (v1.3) requires MAJOR currency units as a
+-- decimal (e.g. 49.99 = $49.99). The cloudpay_v2 provider, rolled out on
+-- 2026-08-07, instead emits MINOR units (integer cents), which inflated all
+-- downstream revenue/AOV by exactly 100x. We normalize that provider's cohort
+-- back to major units here, at the ingestion-contract boundary. The rescale is
+-- scoped strictly to payment_processor = 'cloudpay_v2'; legacy_pos and
+-- shopgate feeds are already contract-compliant and pass through unchanged.
 CREATE OR REPLACE TABLE staging.stg_orders AS
 SELECT
     order_id,
@@ -7,7 +16,11 @@
     CAST(CAST(order_ts AS TIMESTAMP) AS DATE) AS order_day,
     customer_id,
     currency,
-    CAST(amount AS DOUBLE) AS amount,
+    CASE
+        WHEN payment_processor = 'cloudpay_v2'
+            THEN CAST(amount AS DOUBLE) / 100.0
+        ELSE CAST(amount AS DOUBLE)
+    END AS amount,
     payment_processor,
     status
 FROM raw.raw_orders
