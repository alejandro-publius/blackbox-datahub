--- a/pipeline/transforms/stg_orders.sql
+++ b/pipeline/transforms/stg_orders.sql
@@ -1,5 +1,14 @@
 -- stg_orders: cleaned order stream.
 -- Excludes cancelled and refunded orders from the revenue path.
+--
+-- UNIT NORMALIZATION (incident fix, onset 2026-08-07):
+-- raw.raw_orders.amount is contractually MAJOR currency units as a decimal
+-- (contract v1.3, e.g. 49.99 = $49.99). The cloudpay_v2 provider, rolled out
+-- in early August 2026, emits MINOR units (integer cents) instead, which is a
+-- semantic contract violation that still validates as DOUBLE. raw is an
+-- immutable vendor landing table, so staging is the documented normalization
+-- boundary: we rescale the cloudpay_v2 cohort by 1/100 and leave every other
+-- processor untouched. Remove this branch once the provider ships major units.
 CREATE OR REPLACE TABLE staging.stg_orders AS
 SELECT
     order_id,
@@ -7,7 +16,11 @@
     CAST(CAST(order_ts AS TIMESTAMP) AS DATE) AS order_day,
     customer_id,
     currency,
-    CAST(amount AS DOUBLE) AS amount,
+    CASE
+        WHEN payment_processor = 'cloudpay_v2'
+            THEN CAST(amount AS DOUBLE) / 100.0
+        ELSE CAST(amount AS DOUBLE)
+    END AS amount,
     payment_processor,
     status
 FROM raw.raw_orders
